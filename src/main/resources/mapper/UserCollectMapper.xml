<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.healthai.mapper.UserCollectMapper">

    <insert id="insert" parameterType="com.healthai.entity.UserCollectEntity"
            useGeneratedKeys="true" keyProperty="collectId">
        INSERT INTO user_collect (user_id, knowledge_id)
        VALUES (#{userId}, #{knowledgeId})
    </insert>

    <select id="countByUserAndKnowledge" resultType="int">
        SELECT COUNT(*) FROM user_collect
        WHERE user_id = #{userId} AND knowledge_id = #{knowledgeId}
    </select>

    <delete id="deleteByUserAndKnowledge">
        DELETE FROM user_collect
        WHERE user_id = #{userId} AND knowledge_id = #{knowledgeId}
    </delete>

    <select id="selectByUserId" resultType="com.healthai.entity.UserCollectEntity">
        SELECT * FROM user_collect
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>
